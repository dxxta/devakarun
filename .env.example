# PostgreSQL connection used by Payload. Local Docker Compose defaults are shown.
DATABASE_URI=postgres://akarun:akarun@localhost:5432/akarun

# Optional Compose host port override when 5432 is already in use (default: 5432).
# Update DATABASE_URI to match if you set this.
# POSTGRES_PORT=55439

# Replace with a randomly generated secret containing at least 32 characters.
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-chars

# The single Payload administrator account. Replace both example values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-password-at-least-12

# Public base URL for the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to false to allow automated AI crawlers through the request blocker.
# robots.txt disallow rules remain active when disabled.
BLOCK_AI_CRAWLERS=true

# Optional transactional email via the owner's SMTP server. Without SMTP_HOST,
# Payload uses its default console email adapter.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# Optional Cloudflare Turnstile keys for contact and newsletter forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional visitor authentication configuration.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional GitHub API token (raises the unauthenticated rate limit).
GITHUB_TOKEN=

# Optional shared secret for scheduled GitHub sync requests.
CRON_SECRET=

# Optional first-boot portfolio content seed; set to false to disable.
SEED_CONTENT=
